# Copier en ha.env (chmod 600). Jamais dans git : ha.env est dans .gitignore.
# Étape 1 (lecture seule) : URL principale /api/mcp réglée en « Read-only » + « Device control ».
# Étape 2 (commandes) : http://<ha>:8123/api/mcp/assist (seulement les entités exposées à Assist).
HA_MCP_URL=http://192.168.1.50:8123/api/mcp
# Profil d'un utilisateur Home Assistant NON administrateur > Sécurité > Jetons d'accès longue durée.
HA_TOKEN=
