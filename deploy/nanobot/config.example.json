{
  "providers": {
    "lemonade": {
      "apiBase": "${LEMONADE_API_BASE}",
      "apiKey": "lemonade"
    }
  },
  "modelPresets": {
    "rapide": {
      "provider": "lemonade",
      "model": "gemma4-it-e2b-FLM",
      "maxTokens": 256,
      "contextWindowTokens": 32768,
      "temperature": 0.6
    },
    "lourd": {
      "provider": "lemonade",
      "model": "Qwen3-4B-Instruct-2507-GGUF",
      "maxTokens": 2048,
      "contextWindowTokens": 32768,
      "temperature": 0.3
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/nanobot/.nanobot/workspace",
      "modelPreset": "rapide",
      "fallbackModels": ["lourd"],
      "botName": "RUX",
      "timezone": "Europe/Paris",
      "maxToolIterations": 6,
      "maxConcurrentSubagents": 1,
      "disabledSkills": ["skill-creator", "clawhub", "github", "tmux", "image-generation", "nanobot-document", "weather", "cron", "summarize"],
      "dream": { "enabled": true, "modelOverride": "lourd" }
    }
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8900,
    "timeout": 60,
    "apiKey": "${NANOBOT_API_KEY}"
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790
  },
  "channels": {
    "websocket": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 8765,
      "tokenIssueSecret": "${NANOBOT_WEB_TOKEN}",
      "websocketRequiresToken": true
    }
  },
  "tools": {
    "restrictToWorkspace": true,
    "exec": { "enable": false },
    "web": {
      "enable": true,
      "search": { "provider": "duckduckgo", "maxResults": 3, "timeout": 15 },
      "fetch": { "useJinaReader": false }
    },
    "cliApps": { "enable": false },
    "my": { "enable": false },
    "mcpServers": {}
  }
}
