# Copier vers .env et changer les clés (openssl rand -hex 16). Ne pas committer .env.
NANOBOT_API_KEY=change-me
# Mot de passe de la WebUI (http://nimbus:8765). openssl rand -hex 16.
# Obligatoire : le gateway refuse d'écouter sur 0.0.0.0 sans tokenIssueSecret.
# Référencé dans config.json comme ${NANOBOT_WEB_TOKEN} ; la valeur résolue
# n'est pas réécrite sur le disque.
NANOBOT_WEB_TOKEN=change-me-webui
# Adresse d'écoute du port de la WebUI. Défaut : toutes les interfaces (LAN).
# Mettre 127.0.0.1 et un tunnel SSH pour la garder en local.
NANOBOT_WEBUI_BIND=0.0.0.0
# Docker rootless (dockerd lancé par un utilisateur, pas root) : "nimbus" ne
# mène pas à l'hôte depuis le conteneur. Mettre l'IP LAN de nimbus, par exemple
# LEMONADE_API_BASE=http://192.168.2.155:13305/api/v1
LEMONADE_API_BASE=http://nimbus:13305/api/v1
# Path to the nanobot clone (tested commit 5c72ced).
NANOBOT_SRC=./nanobot-src
